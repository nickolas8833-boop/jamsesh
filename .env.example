# ── JamSesh frontend environment ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env to git.

# Your Socket.io server address (local dev default shown)
VITE_SERVER_URL=http://localhost:4000

# Supabase — get these from https://supabase.com → your project → Settings → API
# Leave blank to run the app in offline/demo mode (no auth, no cloud storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
